# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# ---------- 打包产物 ----------
*.exe
*.dmg
*.msi
*.spec.bak
packaging/**/Output/
packaging/**/output/
# 发布产物目录：exe/dmg 由上面两条忽略，此处连同哈希清单一起排除。
# SHA256SUMS.txt 随每次构建变化，属发布物，随 GitHub Release 分发而非入库。
releases/

# ---------- 大体积资源（不入库，构建时脚本下载） ----------
resources/ocr_models/*.onnx
resources/fonts/*.ttf
resources/fonts/*.otf
resources/fonts/*.ttc
!resources/fonts/LICENSE*.txt
!resources/fonts/OFL.txt
!resources/ocr_models/README.md

# ---------- 运行时数据 ----------
*.db
*.db-wal
*.db-shm
cache/
logs/
output/

# ---------- 测试样本（大文件不入库，放 fixtures/_download.md 说明） ----------
tests/fixtures/large/
tests/fixtures/*.pdf
!tests/fixtures/README.md

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 其它 ----------
.env
*.log

# ---------- 本地项目记忆（非软件本体） ----------
.workbuddy/

# ---------- 生成的翻译产物 ----------
out/

# ---------- 其它文档目录（非本项目 docs/，避免误提交） ----------
# 注意：docs/ 是本项目的正式设计文档，已纳入版本管理，不得忽略。
documentation/
documents/

# ---------- 另建输出目录（避免覆盖旧 dist 触发批量删除确认） ----------
dist_release/
build_release/
dist_v2/
build_v2/

# ---------- 体积大的二进制资源（由 scripts/prepare_resources.py 在构建时获取） ----------
resources/fonts/*.ttf
resources/fonts/*.otf
resources/ocr_models/
packaging/win/Output/

# ---------- 最新一次打包输出（新目录，避免覆盖旧 dist 触发批量删除确认） ----------
dist_final/
build_final/
